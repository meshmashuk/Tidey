# Get a free "Discovery" subscription key from https://developer.admiralty.co.uk/
ADMIRALTY_API_KEY=your-subscription-key-here

# Xweather API credentials (client ID + secret) from https://data.portal.xweather.com/account/apps
# Used server-side for current weather (conditions) and sea surface temperature (maritime).
XWEATHER_CLIENT_ID=your-xweather-client-id
XWEATHER_CLIENT_SECRET=your-xweather-client-secret

# Port the proxy server listens on
PORT=8787

# Origin the client dev server runs on (for CORS)
CLIENT_ORIGIN=http://localhost:5173
